# Adapted from Claude global permission rules; broad allow rules are not imported.
prefix_rule(pattern = ["rm", "-rf"], decision = "forbidden", justification = "Claude Code と共通の禁止操作。非破壊的な手順を使用する。")
prefix_rule(pattern = ["rm", "-r"], decision = "forbidden", justification = "Claude Code と共通の禁止操作。非破壊的な手順を使用する。")
prefix_rule(pattern = ["git", "push", "--force"], decision = "forbidden", justification = "Claude Code と共通の禁止操作。非破壊的な手順を使用する。")
prefix_rule(pattern = ["git", "push", "-f"], decision = "forbidden", justification = "Claude Code と共通の禁止操作。非破壊的な手順を使用する。")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "Claude Code と共通の禁止操作。非破壊的な手順を使用する。")
prefix_rule(pattern = ["git", "clean", "-f"], decision = "forbidden", justification = "Claude Code と共通の禁止操作。非破壊的な手順を使用する。")
prefix_rule(pattern = ["chmod", "-R", "777"], decision = "forbidden", justification = "Claude Code と共通の禁止操作。非破壊的な手順を使用する。")
prefix_rule(pattern = ["gog", "gmail", "send"], decision = "prompt", justification = "メール送信・転送・自動返信には明示的なユーザー許可が必要。")
