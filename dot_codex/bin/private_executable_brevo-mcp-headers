#!/bin/zsh
set -euo pipefail

# Brevo is registered as a project-scoped Claude Code MCP server.
# Keep the token out of Codex config, shell history, and command output.
cd /Users/papillon/Code/ai-secretary

claude_output="$(/Users/papillon/.local/bin/claude mcp get brevo 2>/dev/null)"
authorization="$(printf '%s\n' "$claude_output" | sed -n 's/^[[:space:]]*Authorization:[[:space:]]*//p' | head -n 1)"

if [[ -z "$authorization" ]]; then
  print -u2 'Brevo MCP Authorization header was not found in Claude Code configuration.'
  exit 1
fi

jq -n --arg authorization "$authorization" '{Authorization: $authorization}'
