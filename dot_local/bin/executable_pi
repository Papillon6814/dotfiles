#!/usr/bin/env bash
# ~/.local/bin/pi: 全ての pi 起動を pi-profile 経由にする shim。
# 本物の pi は PI_REAL_PI（既定 /opt/homebrew/bin/pi）。
set -euo pipefail

real="${PI_REAL_PI:-/opt/homebrew/bin/pi}"

if [[ "${PI_PROFILE_LAUNCHER:-}" == "0" || "${PI_SUBAGENT_CHILD:-}" == "1" || -n "${PI_PROFILE_LAUNCH_CONTEXT:-}" ]]; then
  exec "$real" "$@"
fi

# セッション id がどのアカウントのものかを、セッションファイルの有無で調べる
session_by_id() {
  local acc
  for acc in muu rbx; do
    if compgen -G "$HOME/.pi/agent-$acc/sessions/*/*_$1.jsonl" >/dev/null; then echo "$HOME/.pi/agent-$acc/"; return 0; fi
  done
  return 0
}

# 再開するセッションが muu/rbx のものなら、そのアカウントで起動する
# --session <パス>・--session=<パス>・--session-id <id>・--session-id=<id> を見る
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  session=""
  if [[ "${args[i]}" == "--session" && $((i + 1)) -lt ${#args[@]} ]]; then
    session="${args[i+1]}"
  elif [[ "${args[i]}" == --session=* ]]; then
    session="${args[i]#--session=}"
  elif [[ "${args[i]}" == "--session-id" && $((i + 1)) -lt ${#args[@]} ]]; then
    session="$(session_by_id "${args[i+1]}")"
  elif [[ "${args[i]}" == --session-id=* ]]; then
    session="$(session_by_id "${args[i]#--session-id=}")"
  else
    continue
  fi
  case "$session" in
    "$HOME/.pi/agent-muu/"*) exec pi-account muu "$@" ;;
    "$HOME/.pi/agent-rbx/"*) exec pi-account rbx "$@" ;;
  esac
  break
done

export PI_PROFILE_PI_BIN="$real"
exec pi-profile launch -- "$@"
