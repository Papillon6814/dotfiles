#!/usr/bin/env python3
"""Create personal AI-agent instruction files in an existing project."""

import argparse
import difflib
import json
import re
import sys
from pathlib import Path


STACK_MARKERS = (
    ("TypeScript / JavaScript", ("package.json", "tsconfig.json")),
    ("Python", ("pyproject.toml", "requirements.txt", "Pipfile")),
    ("Rust", ("Cargo.toml",)),
    ("Go", ("go.mod",)),
    ("Roblox / Lua", ("wally.toml", "aftman.toml", "default.project.json", ".luaurc")),
    ("Ruby", ("Gemfile",)),
    ("PHP", ("composer.json",)),
)
NODE_SCRIPT_ORDER = ("dev", "build", "test", "lint", "typecheck", "check", "start")
NODE_LOCKFILES = (
    ("pnpm-lock.yaml", "pnpm"),
    ("yarn.lock", "yarn"),
    ("bun.lock", "bun"),
    ("bun.lockb", "bun"),
    ("package-lock.json", "npm"),
)
INLINE = chr(96)
WIZARD_STEPS = 8


def safe_text(value):
    if value is None:
        return ""
    return re.sub(r"[\r\n\t]+", " ", str(value)).replace(INLINE, "'").strip()


def find_repo_root(directory):
    for candidate in (directory, *directory.parents):
        if (candidate / ".git").exists():
            return candidate
    return directory


def read_package_json(directory):
    path = directory / "package.json"
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        print("Warning: could not read package.json: {}".format(error), file=sys.stderr)
        return {}
    return data if isinstance(data, dict) else {}


def package_manager(directory, package):
    declared = safe_text(package.get("packageManager", "")).split("@", 1)[0]
    if declared in {"npm", "pnpm", "yarn", "bun"}:
        return declared
    for lockfile, manager in NODE_LOCKFILES:
        if (directory / lockfile).exists():
            return manager
    return "npm"


def project_name(directory, package):
    name = safe_text(package.get("name", ""))
    return name or directory.name


def detected_stacks(directory):
    stacks = []
    for label, markers in STACK_MARKERS:
        if any((directory / marker).exists() for marker in markers):
            stacks.append(label)
    return stacks


def project_commands(directory, package):
    commands = []
    scripts = package.get("scripts", {})
    if isinstance(scripts, dict) and scripts:
        manager = package_manager(directory, package)
        for name in NODE_SCRIPT_ORDER:
            if name in scripts and re.fullmatch(r"[A-Za-z0-9:_-]+", name):
                commands.append("{} run {}".format(manager, name))

    makefile = directory / "Makefile"
    if makefile.is_file():
        try:
            content = makefile.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            content = ""
        for line in content.splitlines():
            match = re.match(r"^([A-Za-z][A-Za-z0-9_-]*):(?:\s|$)", line)
            if match and match.group(1) in NODE_SCRIPT_ORDER:
                command = "make {}".format(match.group(1))
                if command not in commands:
                    commands.append(command)
    return commands


def default_answers(directory, package):
    stacks = detected_stacks(directory)
    return {
        "description": "",
        "stacks": ", ".join(stacks) if stacks else "未検出",
        "commands": project_commands(directory, package),
        "response_language": "日本語",
        "focus": "機能実装、バグ修正、保守性を重視",
        "testing_policy": "ユーザーが依頼した場合のみテストを実行する",
        "git_workflow": "既存ルールを優先し、未定義なら feature branch + worktree を使う",
        "additional_rules": "",
    }


def ask_text(step, emoji, label, question, default="", display_default=None):
    print("\n{} {}/{} {}".format(emoji, step, WIZARD_STEPS, label))
    print("  ? {}".format(question))
    shown_default = default if display_default is None else display_default
    hint = "Enter = {}".format(shown_default) if shown_default else "Enter to skip"
    answer = input("  > [{}] ".format(hint)).strip()
    return safe_text(answer) or default


def ask_choice(step, emoji, label, question, choices, default_index=0):
    print("\n{} {}/{} {}".format(emoji, step, WIZARD_STEPS, label))
    print("  ? {}".format(question))
    for index, (choice_label, _) in enumerate(choices, start=1):
        marker = "●" if index - 1 == default_index else "○"
        print("    {} {}) {}".format(marker, index, choice_label))
    while True:
        answer = input("  > [Enter = {}] ".format(default_index + 1)).strip()
        if not answer:
            return choices[default_index][1]
        if answer.isdigit() and 1 <= int(answer) <= len(choices):
            return choices[int(answer) - 1][1]
        print("    Please enter one of the listed numbers.")

def parse_commands(value):
    normalized = safe_text(value)
    if normalized.lower() in {"", "none", "なし", "-"}:
        return []
    return [command.strip() for command in normalized.split(",") if command.strip()]


def run_wizard(directory, package):
    defaults = default_answers(directory, package)
    detected_stack = defaults["stacks"]
    shown_stack = "Not detected" if detected_stack == "未検出" else detected_stack
    print("\n╭─ 🤖 ai-init")
    print("│ Let's create your AI project instructions.")
    print("│ Press Enter to accept detected values or recommendations.")
    print("╰──────────────────────────")

    description = ask_text(
        1, "✨", "Project overview", "What are you building?"
    )
    print("  🔎 Detected: {}".format(shown_stack))
    stacks = ask_text(
        2,
        "🧩",
        "Tech stack",
        "Add or adjust the detected stack (comma-separated).",
        detected_stack,
        shown_stack,
    )
    detected_commands = ", ".join(defaults["commands"])
    commands_answer = ask_text(
        3,
        "🛠️",
        "Development commands",
        "Which commands should the AI use? Separate multiple commands with commas; type none to clear.",
        detected_commands,
    )
    response_language = ask_choice(
        4,
        "💬",
        "Response language",
        "Which language should the AI use in its replies?",
        (
            ("Japanese", "日本語"),
            ("English", "英語"),
            ("Match the user's language", "ユーザーの言語に合わせる"),
        ),
        0,
    )
    focus = ask_text(
        5,
        "🎯",
        "AI priorities",
        "What should the AI focus on?",
        defaults["focus"],
        "Implementation, bug fixes, and maintainability",
    )
    testing_policy = ask_choice(
        6,
        "🧪",
        "Testing and verification",
        "How should the AI handle tests and checks?",
        (
            (
                "Run relevant tests and checks for each change",
                "変更に合わせて適切なテスト・検証を行う",
            ),
            ("Ask before running them", "実行前に確認する"),
            (
                "Run tests only when explicitly requested",
                "ユーザーが依頼した場合のみ実行する",
            ),
        ),
        2,
    )
    git_workflow = ask_choice(
        7,
        "🌿",
        "Git workflow",
        "How should the AI handle branches and worktrees?",
        (
            (
                "Follow existing rules; otherwise use a feature branch and worktree",
                "既存ルールを優先し、未定義なら feature branch + worktree を使う",
            ),
            ("Work on the current branch", "現在のブランチで作業する"),
            ("Ask me before choosing a workflow", "着手前に方針を確認する"),
        ),
        0,
    )
    additional_rules = ask_text(
        8,
        "📝",
        "Additional instructions",
        "Anything else the AI should follow?",
    )

    answers = {
        "description": description,
        "stacks": stacks,
        "commands": parse_commands(commands_answer),
        "response_language": response_language,
        "focus": focus or defaults["focus"],
        "testing_policy": testing_policy,
        "git_workflow": git_workflow,
        "additional_rules": additional_rules,
    }
    print("\n✅ Answers recorded.")
    print("  📦 {}".format(description or project_name(directory, package)))
    print("  🧩 {}".format("Not detected" if stacks == "未検出" else stacks))
    print("  💬 Language, testing, and Git preferences saved.")
    return answers


def render_agents(directory, package, answers=None):
    answers = answers or default_answers(directory, package)
    name = project_name(directory, package)
    description = answers["description"] or "README / manifest で確認する"
    stacks = answers["stacks"]
    commands = answers["commands"]
    command_lines = "\n".join("- {}{}{}".format(INLINE, command, INLINE) for command in commands)
    if not command_lines:
        command_lines = "- README / CI / manifest で実在を確認してから追記する"
    additional_rules = answers["additional_rules"]
    additional_line = (
        "- {}".format(additional_rules)
        if additional_rules
        else "- 繰り返し必要になるプロジェクト固有ルールはこのファイルへ追加する。"
    )

    return """# {name} — AI エージェント向け指示

## プロジェクト
- 概要: {description}
- 技術スタック: {stacks}
- 技術情報はルート直下の manifest からの検出値を含む。プロジェクトの実態はソースコードでも確認する。

## コマンド
{command_lines}

## AI の進め方
- 返答の言語: {response_language}
- 優先事項: {focus}
- テスト・検証: {testing_policy}
- Git の進め方: {git_workflow}
- 編集前に README、既存の指示ファイル、関連コードを確認し、既存の設計・命名に合わせる。
- 文字列検索には {inline}rg{inline} を使い、コマンドや設定値は manifest とドキュメントで確認する。
- 変更前に {inline}git status{inline} を確認し、ユーザーの既存変更を保護する。
- 破壊的操作、外部送信、公開、push はユーザーの明示許可を得てから行う。
- {additional_line}
- 特定ディレクトリだけの規則は近い階層の {inline}AGENTS.md{inline} に置く。
""".format(
        name=name,
        description=description,
        stacks=stacks,
        command_lines=command_lines,
        response_language=answers["response_language"],
        focus=answers["focus"],
        testing_policy=answers["testing_policy"],
        git_workflow=answers["git_workflow"],
        additional_line=additional_line,
        inline=INLINE,
    )


def preview(path, content):
    lines = content.splitlines(keepends=True)
    diff = difflib.unified_diff(
        [], lines, fromfile="/dev/null", tofile=str(path), n=2
    )
    sys.stdout.writelines(diff)


def main():
    parser = argparse.ArgumentParser(
        description="Create personal AI instruction files in an existing repository."
    )
    parser.add_argument(
        "path",
        nargs="?",
        default=".",
        help="Target repository or directory (default: current directory)",
    )
    parser.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help="Skip questions and final confirmation; use detected defaults",
    )
    args = parser.parse_args()

    target = Path(args.path).expanduser().resolve()
    if not target.is_dir():
        parser.error("directory does not exist: {}".format(target))
    requested_target = target
    target = find_repo_root(target)
    if target == requested_target and not (target / ".git").exists():
        print(
            "Warning: no Git root found; using this directory: {}".format(target),
            file=sys.stderr,
        )

    package = read_package_json(target)
    print("Target: {}".format(target))
    claude_file = target / "CLAUDE.md"
    if claude_file.is_file():
        try:
            claude_instructions = claude_file.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            claude_instructions = ""
        if "@AGENTS.md" not in claude_instructions:
            print(
                "Note: existing CLAUDE.md will not be changed. Add "
                "@AGENTS.md to include the shared instructions.",
                file=sys.stderr,
            )

    missing = [
        filename
        for filename in ("AGENTS.md", "CLAUDE.md")
        if not (target / filename).exists()
    ]
    if not missing:
        print("AGENTS.md and CLAUDE.md already exist. No files were changed.")
        return 0

    if args.yes:
        answers = default_answers(target, package)
    else:
        if not sys.stdin.isatty():
            print(
                "Interactive setup requires a terminal. Use --yes to create files with detected defaults.",
                file=sys.stderr,
            )
            return 2
        try:
            answers = run_wizard(target, package)
        except (EOFError, KeyboardInterrupt):
            print("\nWizard cancelled. No files were created.")
            return 130

    files = {
        "AGENTS.md": render_agents(target, package, answers),
        "CLAUDE.md": "# Claude Code\n\n@AGENTS.md\n",
    }
    pending = [(target / name, content) for name, content in files.items()]
    pending = [(path, content) for path, content in pending if not path.exists()]

    print("\nFiles to create (existing files will not be overwritten):")
    for path, content in pending:
        preview(path, content)

    if not args.yes:
        try:
            answer = input("\nCreate these files? [y/N] ").strip().lower()
        except EOFError:
            answer = ""
        if answer not in {"y", "yes"}:
            print("No files were created.")
            return 0

    for path, content in pending:
        try:
            with path.open("x", encoding="utf-8") as output:
                output.write(content)
        except FileExistsError:
            print("Skipped (created while confirming): {}".format(path.name))
        except OSError as error:
            print("Could not create {}: {}".format(path.name, error), file=sys.stderr)
            return 1
        else:
            print("Created: {}".format(path.name))
    return 0


if __name__ == "__main__":
    sys.exit(main())
