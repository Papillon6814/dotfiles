#!/usr/bin/env python3
import hashlib
import json
import os
from pathlib import Path
import shutil
import tempfile


agent = Path.home() / ".pi/agent"
packages = (
    ("npm/node_modules/pi-hermes-memory", "@earendil-works/pi-tui"),
    ("npm/node_modules/pi-hashline-edit-pro", "typebox"),
    ("npm/node_modules/@schovest/pi-goal", "typebox"),
    ("npm/node_modules/@georgedong32/pi-review", "@sinclair/typebox"),
    ("pi-deep-research-exa", "@sinclair/typebox"),
)

for relative, dependency in packages:
    path = agent / relative / "package.json"
    if not path.is_file():
        continue
    original = path.read_bytes()
    manifest = json.loads(original)
    dependencies = manifest.get("dependencies", {})
    if dependency not in dependencies:
        continue

    # Pi's extension loader supplies these modules, including the legacy TypeBox alias.
    del dependencies[dependency]
    peer = "typebox" if relative == "npm/node_modules/@georgedong32/pi-review" else dependency
    manifest.setdefault("peerDependencies", {})[peer] = "*"
    backup = Path.home() / ".pi/backups/extension-manifests" / hashlib.sha256(original).hexdigest()
    backup.mkdir(parents=True, exist_ok=True, mode=0o700)
    shutil.copy2(path, backup / "package.json")
    fd, temporary = tempfile.mkstemp(prefix=".pi-deps-", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            os.fchmod(output.fileno(), path.stat().st_mode & 0o777)
            output.write(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
