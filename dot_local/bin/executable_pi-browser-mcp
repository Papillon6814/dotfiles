#!/usr/bin/env python3
"""Start pinned Playwright MCP for the explicitly selected Pi account."""
from contextlib import ExitStack
import os
from pathlib import Path
import stat
import sys

PROFILES = {"muu": "Profile 11", "kuno": "Default", "rbx": "Profile 6"}
PACKAGE = "@playwright/mcp@0.0.83"
MAX_TOKEN_BYTES = 4096


def read_token(home: Path, account: str) -> str:
    """Read an owned, private regular file through pinned directory descriptors."""
    if account not in PROFILES:
        raise ValueError("unknown browser account")
    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    with ExitStack() as stack:
        def directory(name, parent=None, private=False):
            fd = os.open(name, directory_flags, dir_fd=parent)
            stack.callback(os.close, fd)
            info = os.fstat(fd)
            if info.st_uid != os.getuid():
                raise ValueError("browser token directory has a different owner")
            mode = stat.S_IMODE(info.st_mode)
            if (private and mode != 0o700) or mode & 0o022:
                raise ValueError("browser token directory permissions must be private")
            return fd

        root = directory(home)
        config = directory(".config", root)
        base = directory("pi-browser", config, private=True)
        tokens = directory("tokens", base, private=True)
        fd = os.open(account, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=tokens)
        stack.callback(os.close, fd)
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600):
            raise ValueError("browser token must be an owned regular file with mode 0600")
        if not 0 < info.st_size <= MAX_TOKEN_BYTES:
            raise ValueError("browser token size is invalid")
        raw = bytearray()
        while len(raw) <= MAX_TOKEN_BYTES:
            chunk = os.read(fd, MAX_TOKEN_BYTES + 1 - len(raw))
            if not chunk:
                break
            raw.extend(chunk)
        if len(raw) > MAX_TOKEN_BYTES:
            raise ValueError("browser token size is invalid")
        try:
            token = raw.decode("utf-8")
        except UnicodeError:
            raise ValueError("browser token encoding is invalid") from None
        if token.endswith("\n"):
            token = token[:-1]
        if not token or any(c.isspace() or ord(c) < 32 or ord(c) == 127 for c in token):
            raise ValueError("browser token content is invalid")
        return token


def main() -> int:
    account = os.environ.get("PI_BROWSER_ACCOUNT", "")
    if len(sys.argv) != 1 or account not in PROFILES:
        print("pi-browser-mcp: explicit supported Pi account required; no browser started", file=sys.stderr)
        return 2
    try:
        token = read_token(Path.home(), account)
    except (OSError, ValueError):
        # Never echo file contents or an exception containing secret material.
        print("pi-browser-mcp: token unavailable or unsafe; configure the selected account's private token", file=sys.stderr)
        return 2
    env = {key: value for key, value in os.environ.items() if not key.startswith("PLAYWRIGHT_MCP_")}
    env["PLAYWRIGHT_MCP_EXTENSION_TOKEN"] = token
    argv = ["npx", "-y", PACKAGE, "--extension", "--profile-dir-name", PROFILES[account]]
    try:
        os.execvpe(argv[0], argv, env)
    except OSError:
        print("pi-browser-mcp: unable to start pinned Playwright MCP", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
