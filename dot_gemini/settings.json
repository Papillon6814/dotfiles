            "name": "clawd",
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/papillon/Documents/Github/clawd-on-desk/hooks/gemini-hook.js\" \"AfterTool\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "clawd",
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/papillon/Documents/Github/clawd-on-desk/hooks/gemini-hook.js\" \"Notification\""
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "clawd",
            "type": "command",
            "command": "\"/opt/homebrew/bin/node\" \"/Users/papillon/Documents/Github/clawd-on-desk/hooks/gemini-hook.js\" \"PreCompress\""
          }
        ]
      }
    ]
  }
