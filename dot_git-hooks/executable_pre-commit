#!/bin/sh
# Generic dispatcher: run the repo-local hook of the same name if it exists.
name="$(basename "$0")"
local_hook="$(git rev-parse --git-common-dir)/hooks/$name"
if [ -x "$local_hook" ] && [ "$(cd "$(dirname "$local_hook")" && pwd)" != "$HOME/.git-hooks" ]; then
  exec "$local_hook" "$@"
fi
