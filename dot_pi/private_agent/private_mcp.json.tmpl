{
  "mcpServers": {
    "playwright-browser": {
      "command": "{{ .chezmoi.homeDir }}/.local/bin/pi-browser-mcp",
      "exposure": "codemode",
      "timeout": 120,
      "description": "Control only the Chrome profile assigned to the Pi account; use only within the user's authorized browser task."
    },
    "codemogger": {
      "command": "npx",
      "args": [
        "-y",
        "codemogger",
        "mcp"
      ],
      "exposure": "codemode"
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.exa.ai/mcp"
      ],
      "exposure": "codemode"
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@iflow-mcp/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "{{ onepasswordRead "op://Personal/Slack Bot Token/credential" }}",
        "SLACK_TEAM_ID": "T073G9UJPML"
      },
      "exposure": "codemode"
    },
    "circleback": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.circleback.ai/mcp"
      ],
      "exposure": "codemode"
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@hachiai/mcp-gmail"
      ],
      "exposure": "codemode"
    },
    "google_calendar": {
      "command": "npx",
      "args": [
        "-y",
        "@cocal/google-calendar-mcp"
      ],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "{{ .chezmoi.homeDir }}/.config/google-calendar-mcp/gcp-oauth.keys.json"
      },
      "exposure": "codemode"
    },
    "blender": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ],
      "exposure": "codemode",
      "timeout": 600.0
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "exposure": "codemode",
      "timeout": 600.0
    },
    "youtube": {
      "command": "{{ .chezmoi.homeDir }}/.cargo/bin/mcp-server-youtube",
      "args": [],
      "env": {
        "YOUTUBE_API_KEY": "{{ onepasswordRead "op://Personal/YouTube API Key/credential" }}"
      },
      "exposure": "codemode",
      "timeout": 600.0
    },
    "zvec_grep": {
      "command": "zg",
      "args": [
        "server",
        "--stdio"
      ],
      "exposure": "codemode",
      "timeout": 600.0
    },
    "honeycomb": {
      "url": "https://mcp.honeycomb.io/mcp",
      "exposure": "codemode"
    }
  }
}
