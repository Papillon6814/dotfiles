{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MCP_TIMEOUT": "600000",
    "MCP_TOOL_TIMEOUT": "600000"
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(lsof *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(uname *)",
      "Bash(env *)",
      "Bash(bc *)",
      "Bash(date *)",
      "Bash(sysctl *)",
      "Bash(vm_stat)",
      "Bash(vm_stat *)",
      "Bash(memory_pressure *)",
      "Bash(top -l *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(node *)",
      "Bash(gh *)",
      "Bash(tsc *)",
      "Bash(cat *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(tree *)",
      "Bash(realpath *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(diff *)",
      "Bash(id *)",
      "Bash(id)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(jq *)",
      "Bash(textutil *)",
      "Bash(openclaw *)",
      "mcp__blender__*",
      "mcp__claude-in-chrome__*",
      "WebFetch",
      "WebSearch",
      "Read",
      "Edit(~/Documents/**)",
      "Edit(~/Downloads/**)",
      "mcp__zvec_grep__*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(chmod -R 777 *)",
      "Bash(> *)"
    ],
    "ask": [
      "Bash(gog gmail send *)",
      "Bash(gog gmail drafts send *)",
      "Bash(gog gmail forward *)",
      "Bash(gog gmail autoreply *)",
      "mcp__gmail__send_email",
      "mcp__mcp-gsuite__reply_gmail_email"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "deniedMcpServers": [
    {
      "serverName": "claude_ai_Notion"
    }
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/notify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/tabby-indicator.sh notify",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/papillon/Library/Application Support/Muxy/hooks/muxy-claude-hook.sh' notification # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/papillon/Library/Application Support/Muxy/hooks/muxy-claude-hook.sh' permission-request # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/tabby-indicator.sh tool-done",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -qE 'gog[[:space:]]+(gmail|mail|email)[[:space:]]+((draft|drafts)[[:space:]]+(send|post)|send|forward|fwd|autoreply)([[:space:]]|$)'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"メール送信は明示的なユーザー許可が必要（厳格ルール 2026-08-17）\"}}'; fi",
            "if": "Bash(gog *)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/tabby-indicator.sh ask",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/papillon/Library/Application Support/Muxy/hooks/muxy-claude-hook.sh' pre-tool-use # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/tabby-indicator.sh end",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/papillon/Library/Application Support/Muxy/hooks/muxy-claude-hook.sh' session-end # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/notify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/tabby-indicator.sh stop",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/papillon/Library/Application Support/Muxy/hooks/muxy-claude-hook.sh' stop # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/tabby-indicator.sh stop",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/papillon/Library/Application Support/Muxy/hooks/muxy-claude-hook.sh' stop-failure # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/tabby-indicator.sh prompt",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/papillon/Library/Application Support/Muxy/hooks/muxy-claude-hook.sh' user-prompt-submit # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/papillon/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh ~/.claude/hooks/herdr-session-context.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "HERDR_PLUGIN_STATE_DIR='/Users/papillon/.local/state/herdr/plugins/herdr-agent-quota' '/Users/papillon/.config/herdr/plugins/github/herdr-agent-quota-651432b09361/target/release/herdr-agent-quota' claude-statusline",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "Notion@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "basicslide@basicslide": true
  },
  "extraKnownMarketplaces": {
    "basicslide": {
      "source": {
        "source": "git",
        "url": "https://github.com/khaym/basicslide.git"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}