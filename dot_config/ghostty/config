shell-integration = fish

font-family = "iosevka"
font-size = 14
font-thicken = true
bold-is-bright = true


cursor-style-blink = false
cursor-style = bar
mouse-hide-while-typing = true

window-decoration = false

confirm-close-surface = false

# Disable all default Command key shortcuts
keybind = super+enter=text:\x19

# Custom keybindings
keybind = cmd+w=esc:.

command = /opt/homebrew/bin/tmux new-session -A -s main

clipboard-paste-protection = false
clipboard-paste-bracketed-safe = true

desktop-notifications = true

# BEGIN herdr-agent-quota font
font-codepoint-map = U+E1A0-U+E1B6="Herdr Agent Icons Max"
font-codepoint-map = U+E1C0-U+E1C5="Herdr Agent Icons Max"
# END herdr-agent-quota font
