          "appToken": "${SLACK_FINNION_APP_TOKEN}",
          "streaming": {
            "mode": "partial",
            "nativeTransport": true
          }
        }
      },
      "typingReaction": "hourglass_flowing_sand",
      "replyToModeByChatType": {
        "direct": "off",
        "group": "first",
        "channel": "first"
      },
      "thread": {
        "historyScope": "thread",
        "inheritParent": false,
        "initialHistoryLimit": 20
      }
    },
    "line": {
      "enabled": true,
      "channelSecret": "${LINE_CHANNEL_SECRET}",
      "channelAccessToken": "${LINE_CHANNEL_ACCESS_TOKEN}",
      "accounts": {
        "default": {
          "dmPolicy": "pairing",
          "enabled": true
