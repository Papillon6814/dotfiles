        "mode": "partial"
      }
    },
    "slack": {
      "enabled": true,
      "groupPolicy": "open",
      "streaming": {
        "mode": "partial",
        "nativeTransport": true
      },
      "accounts": {
        "default": {
          "botToken": "${SLACK_BOT_TOKEN}",
          "appToken": "${SLACK_APP_TOKEN}",
          "streaming": {
            "mode": "partial",
            "nativeTransport": true
