      "model": {
        "primary": "openrouter/deepseek/deepseek-v4-pro",
        "fallbacks": [
          "openrouter/deepseek/deepseek-v3.2",
          "anthropic/claude-sonnet-4-6",
          "anthropic/claude-opus-4-6",
          "anthropic/claude-haiku-4-5-20251001"
